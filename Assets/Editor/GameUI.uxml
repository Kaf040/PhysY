    <ui:VisualElement name="inventory-bar" style="flex-grow: 1; position: absolute; bottom: 20px; align-self: center; flex-direction: row; -unity-background-scale-mode: scale-and-crop;">
        <ui:VisualElement name="item-cube" class="item-card" style="flex-grow: 1; width: 80px; height: 80px; background-color: rgb(51, 51, 51); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; background-image: url(&quot;project://database/Assets/Icons/cube.png?fileID=2800000&amp;guid=8e4bd12802218ab4db856b8fd3dc6560&amp;type=3#cube&quot;); -unity-background-scale-mode: scale-and-crop; background-size: 80% 80%;"/>
    </ui:VisualElement>
    <ui:VisualElement name="object-menu" style="flex-grow: 1; position: absolute; width: 300px; height: 200px; align-self: center; background-color: rgba(30, 30, 30, 0.596); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgba(255, 255, 255, 0.588); border-right-color: rgba(255, 255, 255, 0.588); border-top-color: rgba(255, 255, 255, 0.588); border-bottom-color: rgba(255, 255, 255, 0.588); display: none;">
